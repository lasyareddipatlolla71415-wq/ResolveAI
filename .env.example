# MongoDB — local: mongodb://127.0.0.1:27017/resolveai
#            Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resolveai?retryWrites=true&w=majority
MONGODB_URI=

# Set to "true" in production to crash on missing URI; "false" keeps dev-memory fallback active
MONGODB_REQUIRED=false

# Atlas vector search index name on the knowledgechunks collection (dimensions: 384, similarity: cosine)
MONGODB_VECTOR_INDEX=knowledge_embedding_index

JWT_SECRET=

# LLM provider: "mock" (no key needed) | "openai" | "ollama"
LLM_PROVIDER=mock
LLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model name; leave blank when using mock embeddings
EMBEDDING_MODEL=

# Qdrant — local Docker: http://localhost:6333 | Qdrant Cloud: https://<cluster-id>.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=resolveai_knowledge
QDRANT_VECTOR_SIZE=384

CLIENT_URL=http://localhost:5173
PORT=4000
