{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "npm: dev",
      "command": "pnpm dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*VITE.*ready.*"
        }
      }
    }
  ]
}
